#!/bin/bash
# Modified by Kestrel Contributors (2026) from upstream Herdr (herdr-app, Apache-2.0). See NOTICE.
#
# Builds a release of Kestrel for this machine and packs it into `dist/`:
#
#   scripts/package            -> dist/kestrel-<os>-<arch>.tar.gz (plus .zip & Kestrel.app on macOS)
#   scripts/package <triple>   -> the same for another supported Rust target
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
if [[ $os == macos && $arch != aarch64 ]]; then
  echo "package: Intel Macs aren't supported; build from source instead." >&2
  exit 1
fi
target="$os-$arch"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: kestrel $version for $target"
for notice in LICENSE NOTICE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done

cargo build --release --locked ${triple:+--target "$triple"}

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/kestrel-$target.tar.gz"

if [[ $os == linux || $os == windows ]]; then
  dir="$work/kestrel"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then
    cp "$bin/herdr-app.exe" "$dir/kestrel.exe"
    cp "$bin/herdr-app.exe" "$dir/herdr-app.exe"
  else
    cp "$bin/herdr-app" "$dir/kestrel"
    ln -sfn kestrel "$dir/herdr-app"
  fi
  cp assets/icons/herdr-ui-icon-clean.png "$dir/kestrel.png"
  cp LICENSE NOTICE THIRD-PARTY-NOTICES "$dir/"
  notices_path=kestrel/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" kestrel
else
  app="$work/Kestrel.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/herdr-app" "$app/Contents/MacOS/Kestrel"
  chmod +x "$app/Contents/MacOS/Kestrel"
  cp assets/icons/Kestrel.icns "$app/Contents/Resources/Kestrel.icns"
  cp LICENSE NOTICE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  notices_path=Kestrel.app/Contents/Resources/THIRD-PARTY-NOTICES
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Kestrel</string>
    <key>CFBundleIdentifier</key><string>dev.kestrel.app</string>
    <key>CFBundleName</key><string>Kestrel</string>
    <key>CFBundleDisplayName</key><string>Kestrel</string>
    <key>CFBundleIconFile</key><string>Kestrel</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSHumanReadableCopyright</key><string>Copyright 2026 Kestrel Contributors. Derived from Herdr (Apache-2.0).</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Kestrel can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Kestrel can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Kestrel can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict></dict></plist>
PLIST
  scripts/mac-sign "$app"
  rm -rf dist/Kestrel.app
  ditto "$app" dist/Kestrel.app
  tar -czf "$out" -C "$work" Kestrel.app
  ditto -c -k --sequesterRsrc --keepParent "$app" "dist/Kestrel-${version}-macos-arm64.zip"
fi

tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
notice_path="${notices_path%/*}/NOTICE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
tar -xOf "$out" "$notice_path" | cmp - NOTICE
echo "package: $out ($(sha256 "$out"))"
